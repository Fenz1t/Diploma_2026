{
  "expo": {
    "name": "EmployeeAnalyticsApp",
    "slug": "EmployeeAnalyticsApp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/mainIcon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/mainIcon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1C202A"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/mainIcon.png",
        "backgroundColor": "#1C202A"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.fenz1t.EmployeeAnalyticsApp"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "@react-native-community/datetimepicker"
    ],
    "extra": {
      "eas": {
        "projectId": "48124233-c9b9-4db6-8e9f-942c256a926a"
      }
    }
  }
}
